# Apache / cPanel hosting: barcha manzillarni React’ga yo‘naltirish (/loyihalar, /loyiha/nurobod …)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # http -> https va www -> asosiy domen (vivaconstruction.uz)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://vivaconstruction.uz/$1 [R=301,L]
  # /loyihalar -> /loyihalar/index.html (har sahifaning o‘z SEO fayli)
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Rasmlar va JS/CSS uzoq keshlanadi
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
